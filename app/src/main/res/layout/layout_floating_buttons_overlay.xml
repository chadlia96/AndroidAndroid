<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="30dp"
    android:layout_marginStart="10dp"
    android:padding="5dp"
    android:background="@drawable/bg_floating_overlay"
    android:alpha="0.6">

    <ImageButton
        android:id="@+id/btn1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn2"
        android:background="@null"
        android:contentDescription="@string/floating_overlay_button1_desc"
        android:src="@drawable/outline_ads_click_24" />

    <ImageButton
        android:id="@+id/btn2"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintStart_toStartOf="@id/btn1"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintBottom_toTopOf="@id/btn3"
        android:layout_marginTop="5dp"
        android:background="@null"
        android:contentDescription="@string/floating_overlay_button2_desc"
        android:src="@drawable/outline_add_notes_24" />

    <ImageButton
        android:id="@+id/btn3"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@id/btn1"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintBottom_toTopOf="@id/btn3"
        android:background="@null"
        android:contentDescription="@string/floating_overlay_button3_desc"
        android:src="@drawable/round_add_home_24" />
</androidx.constraintlayout.widget.ConstraintLayout>
